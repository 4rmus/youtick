{
    "name": "livepeer-bridge-worker",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "canary:playback": "node --env-file-if-exists=.dev.vars scripts/playback-canary.mjs",
        "canary:playback:live": "node --env-file-if-exists=.dev.vars scripts/live-playback-canary.mjs",
        "canary:provider": "node --env-file-if-exists=.dev.vars scripts/provider-canary.mjs",
        "check": "tsc --noEmit -p tsconfig.json",
        "dev": "wrangler dev",
        "deploy": "wrangler deploy",
        "test": "vitest",
        "test:playback-v2-abuse": "PLAYBACK_V2_ABUSE_TEST=1 vitest --run src/playback-v2.test.ts -t '100k unauthorized'",
        "test:playback-v2-load": "PLAYBACK_V2_LOAD_TEST=1 vitest --run src/playback-v2.test.ts -t '1k authorized warm'",
        "test:provider-canary": "node --test scripts/*.test.mjs",
        "test:run": "vitest --run"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "4.20260510.1",
        "@vitest/ui": "4.1.5",
        "esbuild": "0.27.3",
        "tus-js-client": "4.3.1",
        "typescript": "5.9.3",
        "vitest": "4.1.5",
        "wrangler": "4.90.0"
    },
    "dependencies": {
        "@defuse-protocol/one-click-sdk-typescript": "0.1.25",
        "near-api-js": "7.3.0"
    }
}
