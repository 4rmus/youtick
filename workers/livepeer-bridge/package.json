{
    "name": "livepeer-bridge-worker",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "canary:playback": "node --env-file-if-exists=.dev.vars scripts/playback-canary.mjs",
        "canary:playback:live": "node --env-file-if-exists=.dev.vars scripts/live-playback-canary.mjs",
        "canary:provider": "node --env-file-if-exists=.dev.vars scripts/provider-canary.mjs",
        "check": "tsc --noEmit -p tsconfig.json",
        "dev": "wrangler dev",
        "deploy": "wrangler deploy",
        "test": "vitest",
        "test:provider-canary": "node --test scripts/*.test.mjs ../../apps/web/scripts/livepeer-hls-browser-canary.test.mjs",
        "test:run": "vitest --run"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "4.20260510.1",
        "@vitest/ui": "4.1.5",
        "esbuild": "0.27.3",
        "tus-js-client": "4.3.1",
        "typescript": "5.9.3",
        "vitest": "4.1.5",
        "wrangler": "4.90.0"
    },
    "dependencies": {
        "near-api-js": "7.3.0"
    }
}
