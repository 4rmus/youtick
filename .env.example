# NEAR Protocol Configuration
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NFT_CONTRACT_ID=your-contract.testnet

# Lighthouse (IPFS) Configuration
# Get from: https://lighthouse.storage
NEXT_PUBLIC_LIGHTHOUSE_API_KEY=your_lighthouse_api_key_here

# Livepeer Configuration (Server-side only - SECURE)
# Get from: https://livepeer.studio
# Used for transcoding IPFS videos to HLS
LIVEPEER_API_KEY=your_livepeer_api_key_here
