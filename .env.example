# NEAR Protocol Configuration
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NFT_CONTRACT_ID=v1-1.utick.testnet

# Lit Protocol Configuration
# IPFS CID of the Lit Action for NEAR signature verification
# Get this by uploading lit_actions/verify_near.js to IPFS
NEXT_PUBLIC_LIT_ACTION_IPFS_CID=your_lit_action_cid_here

# Lighthouse (IPFS) Storage - Server-side only
LIGHTHOUSE_API_KEY=your_lighthouse_api_key_here

# PKP Relayer - Optional (for sponsored PKP minting)
# Generate with: openssl rand -hex 32
# Fund the wallet on Chronicle Yellowstone with tstLPX
RELAYER_PRIVATE_KEY=your_relayer_private_key_here
