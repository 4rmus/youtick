# NEAR Protocol Configuration
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NFT_CONTRACT_ID=v1.utick.testnet

# Lit Protocol Configuration
# Lit Action IPFS CID for NEAR access control verification
NEXT_PUBLIC_LIT_ACTION_IPFS_CID=Qmc6cLer2fmtuzNFhdtBoZvM1gCzX9s8gbc8wzWdizeuJe
# Lit Capacity Token ID for rate limiting
NEXT_PUBLIC_LIT_CAPACITY_TOKEN_ID=354131
# Ethereum private key for Lit PKP delegation (Chronicle Yellowstone)
LIT_DELEGATION_WALLET_PRIVATE_KEY=0x...your_ethereum_private_key

# Lighthouse Storage - IPFS upload API key
# Get from: https://lighthouse.storage
LIGHTHOUSE_API_KEY=your_lighthouse_api_key

# NEAR Relayer Configuration
# Sub-account for sponsored transactions (trial accounts, free ticket claims)
# Create with: near account create-account fund-myself relayer.CONTRACT_ID 'AMOUNT' ...
RELAYER_ACCOUNT_ID=relayer.v1.utick.testnet
RELAYER_PRIVATE_KEY=ed25519:...your_relayer_private_key

# Optional: App URL for gift claim links (defaults to localhost:3000)
# NEXT_PUBLIC_APP_URL=https://youtick.net
