# Supabase Configuration
# Get these from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# NEAR Protocol Configuration
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NFT_CONTRACT_ID=your-nft-contract.testnet

# Livepeer Video Streaming Configuration
# Get these from: Livepeer Studio Dashboard
LIVEPEER_API_KEY=your_livepeer_api_key_here
LIVEPEER_PRIVATE_KEY=your_livepeer_private_key_here
LIVEPEER_PUBLIC_KEY=your_livepeer_public_key_here

# Lighthouse (IPFS) Configuration
# Get from: https://lighthouse.storage
LIGHTHOUSE_API_KEY=your_lighthouse_api_key_here
