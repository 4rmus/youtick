{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtick.net/protocol/paid-media-livepeer-v1/schema.json",
  "title": "YouTick paid media Livepeer v1 golden vectors",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id",
    "profile_id",
    "limits",
    "operator",
    "public_testnet_beta",
    "upload_intent",
    "creator_fee_quote",
    "sponsored_upload_quote",
    "finalize_publication",
    "playback_token_request"
  ],
  "properties": {
    "protocol_id": {
      "const": "youtick.paid-media-livepeer-v1.protocol.v1"
    },
    "profile_id": {
      "const": "paid-media-livepeer-v1"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_source_bytes",
        "tus_chunk_bytes",
        "parallel_uploads",
        "min_ticket_price_usdc",
        "upload_fee_usdc_per_decimal_gb",
        "min_upload_fee_usdc",
        "monthly_operation_budget",
        "initial_browser_matrix"
      ],
      "properties": {
        "max_source_bytes": {
          "const": "20000000000"
        },
        "tus_chunk_bytes": {
          "const": "33554432"
        },
        "parallel_uploads": {
          "const": 1
        },
        "min_ticket_price_usdc": {
          "const": "2000000"
        },
        "upload_fee_usdc_per_decimal_gb": {
          "const": "300000"
        },
        "min_upload_fee_usdc": {
          "const": "500000"
        },
        "monthly_operation_budget": {
          "const": "UNLIMITED"
        },
        "initial_browser_matrix": {
          "const": ["desktop-chrome", "desktop-edge"]
        }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_names", "deposit_yocto", "full_access"],
      "properties": {
        "method_names": {
          "const": [
            "finalize_livepeer_publication",
            "suspend_livepeer_sales"
          ]
        },
        "deposit_yocto": {
          "const": "0"
        },
        "full_access": {
          "const": false
        }
      }
    },
    "public_testnet_beta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_source_bytes",
        "max_jobs",
        "jobs_per_creator_utc_day",
        "upload_days",
        "total_days",
        "job_ttl_ms",
        "start_runway_bytes",
        "emergency_runway_bytes",
        "sponsor_quote_required",
        "native_near_upload_enabled"
      ],
      "properties": {
        "max_source_bytes": { "const": "1000000000" },
        "max_jobs": { "const": 10 },
        "jobs_per_creator_utc_day": { "const": 1 },
        "upload_days": { "const": 13 },
        "total_days": { "const": 14 },
        "job_ttl_ms": { "const": "86400000" },
        "start_runway_bytes": { "const": "100000" },
        "emergency_runway_bytes": { "const": "25000" },
        "sponsor_quote_required": { "const": true },
        "native_near_upload_enabled": { "const": false }
      }
    },
    "upload_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "canonical_body",
        "body_sha256",
        "envelope",
        "canonical_message"
      ],
      "properties": {
        "body": {
          "$ref": "#/$defs/upload_intent_body"
        },
        "canonical_body": {
          "type": "string",
          "minLength": 1
        },
        "body_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "envelope": {
          "$ref": "#/$defs/control_envelope"
        },
        "canonical_message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "creator_fee_quote": {
      "$ref": "#/$defs/creator_fee_quote"
    },
    "sponsored_upload_quote": {
      "$ref": "#/$defs/sponsored_upload_quote"
    },
    "finalize_publication": {
      "$ref": "#/$defs/finalize_publication"
    },
    "playback_token_request": {
      "$ref": "#/$defs/playback_token_request"
    }
  },
  "$defs": {
    "plain_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decimal_u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "account_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,62}[a-z0-9]$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "playback_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{6,128}$"
    },
    "upload_intent_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "generation",
        "expected_source_bytes",
        "source_fingerprint_sha256",
        "source_type",
        "profile_id",
        "profile_config_sha256"
      ],
      "properties": {
        "job_id": {
          "$ref": "#/$defs/job_id"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "expected_source_bytes": {
          "$ref": "#/$defs/decimal_u64"
        },
        "source_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_type": {
          "enum": ["mp4", "mov", "avi", "webm", "wmv", "mkv", "flv"]
        },
        "profile_id": {
          "const": "paid-media-livepeer-v1"
        },
        "profile_config_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "control_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "version",
        "method",
        "route",
        "network",
        "contract_id",
        "account_id",
        "resource",
        "session_public_key",
        "origin",
        "device_nonce",
        "expires_at_ms",
        "body_sha256"
      ],
      "properties": {
        "domain": {
          "const": "youtick.paid-media-livepeer-v1.control"
        },
        "version": {
          "enum": ["2", "3"]
        },
        "method": {
          "const": "POST"
        },
        "route": {
          "enum": [
            "/v1/upload-intents",
            "/v1/upload-heartbeats",
            "/v1/upload-cancellations",
            "/v1/playback-tokens"
          ]
        },
        "network": {
          "enum": ["testnet", "mainnet"]
        },
        "contract_id": {
          "$ref": "#/$defs/account_id"
        },
        "account_id": {
          "$ref": "#/$defs/account_id"
        },
        "resource": {
          "$ref": "#/$defs/plain_string"
        },
        "session_public_key": {
          "type": "string",
          "pattern": "^ed25519:[1-9A-HJ-NP-Za-km-z]{32,64}$"
        },
        "origin": {
          "type": "string",
          "pattern": "^https://[^\\r\\n]+$"
        },
        "device_nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "expires_at_ms": {
          "$ref": "#/$defs/decimal_u64"
        },
        "body_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "finalize_publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "generation",
        "creator_id",
        "expected_source_bytes",
        "profile_id",
        "profile_config_sha256",
        "asset_id_hash",
        "playback_id",
        "project_id_hash",
        "verified_source_bytes",
        "ready_at_ms",
        "availability"
      ],
      "properties": {
        "job_id": {
          "$ref": "#/$defs/job_id"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "creator_id": {
          "$ref": "#/$defs/account_id"
        },
        "expected_source_bytes": {
          "$ref": "#/$defs/decimal_u64"
        },
        "profile_id": {
          "const": "paid-media-livepeer-v1"
        },
        "profile_config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "asset_id_hash": {
          "$ref": "#/$defs/sha256"
        },
        "playback_id": {
          "$ref": "#/$defs/playback_id"
        },
        "project_id_hash": {
          "$ref": "#/$defs/sha256"
        },
        "verified_source_bytes": {
          "$ref": "#/$defs/decimal_u64"
        },
        "provider_source_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "ready_at_ms": {
          "$ref": "#/$defs/decimal_u64"
        },
        "availability": {
          "enum": ["ACTIVE", "SALES_SUSPENDED", "TAKEDOWN"]
        }
      }
    },
    "creator_fee_quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "canonical_message", "quote_id", "signature_base64", "public_key_base64"],
      "properties": {
        "quote": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "version", "network", "contract_id", "creator_id", "job_id", "expected_source_bytes", "fee_usd_micro", "near_usd_micro", "fee_near_yocto", "rate_source", "rate_timestamp_ms", "expires_at_ms", "quote_key_version", "quote_id"],
          "properties": {
            "domain": { "const": "youtick.creator-fee-quote" },
            "version": { "const": "1" },
            "network": { "enum": ["testnet", "mainnet"] },
            "contract_id": { "$ref": "#/$defs/account_id" },
            "creator_id": { "$ref": "#/$defs/account_id" },
            "job_id": { "$ref": "#/$defs/job_id" },
            "expected_source_bytes": { "$ref": "#/$defs/decimal_u64" },
            "fee_usd_micro": { "$ref": "#/$defs/decimal_u64" },
            "near_usd_micro": { "$ref": "#/$defs/decimal_u64" },
            "fee_near_yocto": { "type": "string", "pattern": "^[1-9][0-9]{0,38}$" },
            "rate_source": { "$ref": "#/$defs/plain_string" },
            "rate_timestamp_ms": { "$ref": "#/$defs/decimal_u64" },
            "expires_at_ms": { "$ref": "#/$defs/decimal_u64" },
            "quote_key_version": { "type": "integer", "minimum": 1 },
            "quote_id": { "$ref": "#/$defs/sha256" }
          }
        },
        "canonical_message": { "type": "string", "minLength": 1 },
        "quote_id": { "$ref": "#/$defs/sha256" },
        "signature_base64": { "type": "string", "minLength": 86 },
        "public_key_base64": { "type": "string", "minLength": 43 }
      }
    },
    "paid_job_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creator_id", "job_id", "title", "price_usdc", "expected_source_bytes", "profile_id", "profile_config_sha256", "upload_public_key", "upload_key_expires_at_ms"],
      "properties": {
        "creator_id": { "$ref": "#/$defs/account_id" },
        "job_id": { "$ref": "#/$defs/job_id" },
        "title": { "type": "string", "minLength": 1 },
        "price_usdc": { "$ref": "#/$defs/decimal_u64" },
        "expected_source_bytes": { "$ref": "#/$defs/decimal_u64" },
        "profile_id": { "const": "paid-media-livepeer-v1" },
        "profile_config_sha256": { "$ref": "#/$defs/sha256" },
        "upload_public_key": { "$ref": "#/$defs/plain_string" },
        "upload_key_expires_at_ms": { "$ref": "#/$defs/decimal_u64" }
      }
    },
    "sponsored_upload_quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paid_job_request", "request_json", "request_sha256", "quote", "canonical_message", "quote_id", "signature_base64", "public_key_base64"],
      "properties": {
        "paid_job_request": { "$ref": "#/$defs/paid_job_request" },
        "request_json": { "type": "string", "minLength": 1 },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "quote": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "version", "network", "contract_id", "creator_id", "job_id", "request_sha256", "expected_source_bytes", "upload_fee_usdc", "sponsor_fee_usdc", "total_fee_usdc", "delegate_receiver_id", "delegate_method", "delegate_gas", "delegate_deposit_yocto", "issued_at_ms", "quote_block_height", "max_delegate_block_height", "expires_at_ms", "quote_key_version", "quote_id"],
          "properties": {
            "domain": { "const": "youtick.sponsored-upload-quote" },
            "version": { "const": "1" },
            "network": { "enum": ["testnet", "mainnet"] },
            "contract_id": { "$ref": "#/$defs/account_id" },
            "creator_id": { "$ref": "#/$defs/account_id" },
            "job_id": { "$ref": "#/$defs/job_id" },
            "request_sha256": { "$ref": "#/$defs/sha256" },
            "expected_source_bytes": { "$ref": "#/$defs/decimal_u64" },
            "upload_fee_usdc": { "$ref": "#/$defs/decimal_u64" },
            "sponsor_fee_usdc": { "const": "100000" },
            "total_fee_usdc": { "$ref": "#/$defs/decimal_u64" },
            "delegate_receiver_id": { "$ref": "#/$defs/account_id" },
            "delegate_method": { "const": "ft_transfer_call" },
            "delegate_gas": { "const": "100000000000000" },
            "delegate_deposit_yocto": { "const": "1" },
            "issued_at_ms": { "$ref": "#/$defs/decimal_u64" },
            "quote_block_height": { "$ref": "#/$defs/decimal_u64" },
            "max_delegate_block_height": { "$ref": "#/$defs/decimal_u64" },
            "expires_at_ms": { "$ref": "#/$defs/decimal_u64" },
            "quote_key_version": { "type": "integer", "minimum": 1 },
            "quote_id": { "$ref": "#/$defs/sha256" }
          }
        },
        "canonical_message": { "type": "string", "minLength": 1 },
        "quote_id": { "$ref": "#/$defs/sha256" },
        "signature_base64": { "type": "string", "minLength": 86 },
        "public_key_base64": { "type": "string", "minLength": 43 }
      }
    },
    "playback_token_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "canonical_body",
        "body_sha256",
        "envelope",
        "canonical_message"
      ],
      "properties": {
        "body": {
          "$ref": "#/$defs/playback_token_body"
        },
        "canonical_body": {
          "type": "string",
          "minLength": 1
        },
        "body_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "envelope": {
          "$ref": "#/$defs/control_envelope"
        },
        "canonical_message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "playback_token_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "generation",
        "playback_id",
        "grant_id",
        "origin_hash",
        "device_hash",
        "requested_ttl_seconds"
      ],
      "properties": {
        "job_id": {
          "$ref": "#/$defs/job_id"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "playback_id": {
          "$ref": "#/$defs/playback_id"
        },
        "grant_id": {
          "$ref": "#/$defs/plain_string"
        },
        "origin_hash": {
          "$ref": "#/$defs/sha256"
        },
        "device_hash": {
          "$ref": "#/$defs/sha256"
        },
        "requested_ttl_seconds": {
          "type": "integer",
          "minimum": 120,
          "maximum": 300
        }
      }
    }
  }
}
