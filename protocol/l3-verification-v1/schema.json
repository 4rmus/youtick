{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtick.net/schemas/l3-verification-v1.json",
  "title": "YouTick L3 readback verification queue message v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "verificationId",
    "jobId",
    "generation",
    "ordinal"
  ],
  "properties": {
    "schema": {
      "const": "youtick.l3-readback.verify.v1"
    },
    "verificationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "ordinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    }
  }
}
