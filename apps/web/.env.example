# YouTick web app environment
# Copy to apps/web/.env.local and adjust values for your setup.

# ------------------------------------------------------------------------------
# Required
# ------------------------------------------------------------------------------
NEXT_PUBLIC_NEAR_NETWORK=mainnet
NEXT_PUBLIC_NFT_CONTRACT_ID=youtick.near
NEXT_PUBLIC_MARKET_CONTRACT_ID=youtick.near
NEXT_PUBLIC_ACCESS_CONTRACT_ID=access.youtick.near
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=registry.youtick.near

# ------------------------------------------------------------------------------
# Optional public values
# ------------------------------------------------------------------------------
# Override the default KMS worker URL (production: https://youtick-kms.<account>.workers.dev).
NEXT_PUBLIC_KMS_URL=

# Public app URL used when generating gift links.
NEXT_PUBLIC_APP_URL=https://youtick.net

# Core-only mainnet launch defaults.
NEXT_PUBLIC_ENABLE_CROSS_CHAIN_CHECKOUT=false

# Onboarding key for browser-side trial creation.
# This is a Function Call Access Key pre-registered in the contract via add_onboarding_key.
# Required for guest/trial account creation without a relayer.
# SECURITY: This MUST NOT use NEXT_PUBLIC_ prefix. It is served via a server-side
# /api/onboarding-key endpoint so it never leaks into the client JS bundle.
ONBOARDING_KEY=

# Partner token for 1Click cross-chain quotes and swaps.
NEXT_PUBLIC_ONE_CLICK_API_TOKEN=

# Used by build:web4 to switch Next.js output behaviour.
# NEXT_PUBLIC_DEPLOY_TARGET=web4

# ------------------------------------------------------------------------------
# Optional server-only values
# ------------------------------------------------------------------------------
# NOTE: Relayer-based trial creation has been deprecated.
# Trial and guest flows now use onboarding keys (ONBOARDING_KEY, server-side only).
# RELAYER_ACCOUNT_ID and RELAYER_PRIVATE_KEY are no longer required.

# ------------------------------------------------------------------------------
# Sentry (optional)
# ------------------------------------------------------------------------------
# Error/performance reporting. Empty DSN disables Sentry (app still runs).
# NEXT_PUBLIC_SENTRY_DSN=
#
# Slugs for @sentry/nextjs source map upload (next.config.ts → withSentryConfig).
SENTRY_ORG=youtick
SENTRY_PROJECT=javascript-nextjs
#
# Build/CI only — never NEXT_PUBLIC_. Create: Settings → Developer Settings → Auth Tokens.
# SENTRY_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# Testnet example (for local development)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_NEAR_NETWORK=testnet
# NEXT_PUBLIC_NFT_CONTRACT_ID=dev-fresh-kurulum-3.testnet
# NEXT_PUBLIC_MARKET_CONTRACT_ID=dev-fresh-kurulum-3.testnet
# NEXT_PUBLIC_ACCESS_CONTRACT_ID=<access-xxx.utick.testnet>
# NEXT_PUBLIC_REGISTRY_CONTRACT_ID=<registry-xxx.utick.testnet>
# NEXT_PUBLIC_KMS_URL=http://localhost:8787
# NEXT_PUBLIC_APP_URL=http://localhost:3000
