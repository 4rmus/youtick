# YouTick web app environment
# Copy to apps/web/.env.local and adjust values for your setup.

# ------------------------------------------------------------------------------
# Required
# ------------------------------------------------------------------------------
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NFT_CONTRACT_ID=v1.utick.testnet
NEXT_PUBLIC_MARKET_CONTRACT_ID=v1.utick.testnet
NEXT_PUBLIC_ACCESS_CONTRACT_ID=access.v1.utick.testnet
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=registry.v1.utick.testnet

# ------------------------------------------------------------------------------
# Optional public values
# ------------------------------------------------------------------------------
# Override the default KMS worker URL.
NEXT_PUBLIC_KMS_URL=

# Public app URL used when generating gift links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Legacy onboarding key for browser-side trial creation.
# Leave empty for the zero-trust target path.
NEXT_PUBLIC_ONBOARDING_KEY=

# Partner token for 1Click cross-chain quotes and swaps.
NEXT_PUBLIC_ONE_CLICK_API_TOKEN=

# Used by build:web4 to switch Next.js output behaviour.
# NEXT_PUBLIC_DEPLOY_TARGET=web4

# ------------------------------------------------------------------------------
# Optional server-only values
# ------------------------------------------------------------------------------
# Fallback relayer for sponsored trial flows.
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
