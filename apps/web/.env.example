# Required. Use fresh market/access contract IDs for this Livepeer-only state.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_MARKET_CONTRACT_ID=<fresh-market-contract.testnet>
NEXT_PUBLIC_ACCESS_CONTRACT_ID=<fresh-access-contract.testnet>

# Optional canonical USDC override. Network defaults are used when omitted.
# NEXT_PUBLIC_USDC_CONTRACT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LIVEPEER_BRIDGE_URL=https://youtick-livepeer-bridge.<subdomain>.workers.dev

# Required by the upload flow even while the native-NEAR fee rail is disabled.
NEXT_PUBLIC_LIVEPEER_CREATOR_FEE_GAS_RESERVE_YOCTO=<approved-positive-yoctonear>

# Release gates remain false until separately approved.
NEXT_PUBLIC_ENABLE_PAID_MEDIA_LIVEPEER_V1=false
NEXT_PUBLIC_ENABLE_PLAYBACK_AUTHORIZER_V2=false
NEXT_PUBLIC_ENABLE_PLAYBACK_SHADOW_V2=false
NEXT_PUBLIC_ENABLE_LIVEPEER_NEAR_CREATOR_FEE=false
NEXT_PUBLIC_ENABLE_SPONSORED_LIVEPEER_UPLOADS=false
NEXT_PUBLIC_ENABLE_DERIVED_READ_MODEL=false

# Required only when the derived read-model gate is true. Must be an exact
# HTTPS origin; the separate read Worker must allow this app origin.
# NEXT_PUBLIC_MARKET_READ_MODEL_URL=https://youtick-market-read.<subdomain>.workers.dev

# Optional server-only dedicated RPC primary. Keep authorization out of any
# NEXT_PUBLIC variable; controlled public fallback remains available when unset.
# NEAR_RPC_PRIMARY_URL=https://<dedicated-near-rpc-host>/
# NEAR_RPC_PRIMARY_AUTHORIZATION=Bearer <provider-token>
