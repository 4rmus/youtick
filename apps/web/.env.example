# YouTick Web App - Environment Variables
# ==============================================================================
# 100% Decentralized - No API keys required for core operations
# ==============================================================================

# ==============================================================================
# NEAR Configuration (Required)
# ==============================================================================
NEXT_PUBLIC_NEAR_NETWORK=testnet                           # testnet or mainnet
NEXT_PUBLIC_NFT_CONTRACT_ID=v1.utick.testnet               # NFT contract account ID

# ==============================================================================
# Lit Protocol Configuration (Required)
# ==============================================================================
NEXT_PUBLIC_LIT_NETWORK=datil-test                         # datil-test (testnet) or datil (mainnet)
NEXT_PUBLIC_LIT_ACTION_IPFS_CID=your-lit-action-cid        # Lit Action IPFS CID for access control
NEXT_PUBLIC_LIT_CAPACITY_TOKEN_ID=your-capacity-token-id   # Lit Protocol capacity credit token ID
LIT_DELEGATION_WALLET_PRIVATE_KEY=0x...                    # ETH private key for capacity delegation

# ==============================================================================
# Crust Network / IPFS Storage
# ==============================================================================
# Note: Crust uses W3Auth with NEAR Session Keys - NO API KEY NEEDED!
# Authentication happens client-side using your NEAR wallet signature.
# Upload Gateways: crustipfs.xyz, gw.crustfiles.app
# Retrieval Gateways: crustipfs.xyz, gw.crustfiles.app, dweb.link, ipfs.io

# ==============================================================================
# Trial Accounts (Optional)
# ==============================================================================
# Only needed for sponsored trial account creation
RELAYER_ACCOUNT_ID=your-relayer.testnet                    # NEAR account ID for relayer
RELAYER_PRIVATE_KEY=ed25519:...                            # NEAR private key for relayer

# ==============================================================================
# DEPRECATED - No Longer Needed
# ==============================================================================
# LIGHTHOUSE_API_KEY=...           # Replaced by Crust W3Auth (client-side)
# LIT_RELAY_URL=...                # Replaced by NEAR MPC Chain Signatures
# LIT_RELAYER_API_KEY=...          # Replaced by NEAR MPC Chain Signatures
