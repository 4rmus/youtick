# Required. Use fresh market/access contract IDs for this Livepeer-only state.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_MARKET_CONTRACT_ID=<fresh-market-contract.testnet>
NEXT_PUBLIC_ACCESS_CONTRACT_ID=<fresh-access-contract.testnet>

# Optional canonical USDC override. Network defaults are used when omitted.
# NEXT_PUBLIC_USDC_CONTRACT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LIVEPEER_BRIDGE_URL=https://youtick-livepeer-bridge.<subdomain>.workers.dev

# Release gates: both remain false until separately approved.
NEXT_PUBLIC_ENABLE_PAID_MEDIA_LIVEPEER_V1=false
NEXT_PUBLIC_ENABLE_LIVEPEER_NEAR_CREATOR_FEE=false
