# YouTick web app environment
# Copy to apps/web/.env.local and adjust values for your setup.

# ------------------------------------------------------------------------------
# Required
# ------------------------------------------------------------------------------
NEXT_PUBLIC_NEAR_NETWORK=mainnet
NEXT_PUBLIC_NFT_CONTRACT_ID=youtick.near
NEXT_PUBLIC_MARKET_CONTRACT_ID=youtick.near
NEXT_PUBLIC_ACCESS_CONTRACT_ID=access.youtick.near
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=registry.youtick.near

# ------------------------------------------------------------------------------
# Optional public values
# ------------------------------------------------------------------------------
# Public app URL used when generating gift links.
NEXT_PUBLIC_APP_URL=https://youtick.net

# Core-only mainnet launch defaults.
NEXT_PUBLIC_ENABLE_CROSS_CHAIN_CHECKOUT=false
# Optional 1Click/Rhea partner settings for cross-chain checkout.
# NEXT_PUBLIC_ONE_CLICK_API_TOKEN=
# NEXT_PUBLIC_RHEA_REFERRAL_ID=

# Lighthouse is the only write path through the Storage API Worker.
NEXT_PUBLIC_ENABLE_LIGHTHOUSE_PRIMARY_UPLOAD=true

# Storage API Worker. Required for Lighthouse uploads and CID status checks.
# Keep persistence disabled unless the worker is deployed and configured with
# its server-side Lighthouse secret.
NEXT_PUBLIC_ENABLE_LIGHTHOUSE_PERSISTENCE=false
# NEXT_PUBLIC_STORAGE_API_URL=https://youtick-storage-api.<subdomain>.workers.dev

# Paid-media v4 browser-to-private-R2 ingest. Keep false until the exact 20 GB,
# resume and supported-browser provider canaries pass.
NEXT_PUBLIC_ENABLE_PAID_MEDIA_V4_INGEST=false

# Optional hot media delivery Worker for encrypted IPFS manifest/segment reads.
NEXT_PUBLIC_ENABLE_MEDIA_DELIVERY_WORKER=false
# NEXT_PUBLIC_MEDIA_DELIVERY_URL=https://youtick-media-delivery.<subdomain>.workers.dev

# Onboarding key for the server-side trial endpoint.
# This is a Function Call Access Key pre-registered in the contract via add_onboarding_key.
# Required for guest/trial account creation without a relayer.
# SECURITY: This MUST NOT use NEXT_PUBLIC_ prefix. It is served via a server-side
# /api/onboarding-key endpoint so it never leaks into the client JS bundle.
ONBOARDING_KEY=

# Multiple onboarding keys (comma-separated). Falls back to ONBOARDING_KEY if not set.
# Use this to support key rotation and distribute load across multiple keys.
ONBOARDING_KEYS=

# Cloudflare Turnstile secret key for /api/onboarding-key challenge verification.
# When TURNSTILE_SECRET_KEY is set, clients must pass a Turnstile token to
# receive an onboarding key. Set NEXT_PUBLIC_TURNSTILE_SITE_KEY so the UI can
# render the challenge.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Used by build:web4 to switch Next.js output behaviour.
# NEXT_PUBLIC_DEPLOY_TARGET=web4

# Optional playback troubleshooting. Do not enable in production by default.
# NEXT_PUBLIC_DEBUG_PLAYBACK=true

# ------------------------------------------------------------------------------
# Optional server-only values
# ------------------------------------------------------------------------------
# NOTE: Relayer-based trial creation has been deprecated.
# Trial and guest flows now use onboarding keys (ONBOARDING_KEY, server-side only).
# RELAYER_ACCOUNT_ID and RELAYER_PRIVATE_KEY are no longer required.

# ------------------------------------------------------------------------------
# Sentry (optional)
# ------------------------------------------------------------------------------
# Error/performance reporting. Empty DSN disables Sentry (app still runs).
NEXT_PUBLIC_SENTRY_ENABLED=false
# NEXT_PUBLIC_SENTRY_DSN=
#
# Slugs for @sentry/nextjs source map upload (next.config.ts → withSentryConfig).
SENTRY_ORG=youtick
SENTRY_PROJECT=javascript-nextjs
#
# Build/CI only — never NEXT_PUBLIC_. Create: Settings → Developer Settings → Auth Tokens.
# SENTRY_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# Testnet example (for local development)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_NEAR_NETWORK=testnet
# NEXT_PUBLIC_NFT_CONTRACT_ID=<your-market-contract.testnet>
# NEXT_PUBLIC_MARKET_CONTRACT_ID=<your-market-contract.testnet>
# NEXT_PUBLIC_ACCESS_CONTRACT_ID=<access-xxx.utick.testnet>
# NEXT_PUBLIC_REGISTRY_CONTRACT_ID=<registry-xxx.utick.testnet>
# NEXT_PUBLIC_APP_URL=http://localhost:3000
