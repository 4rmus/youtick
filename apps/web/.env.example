# YouTick Web App - Environment Variables

# NEAR Configuration
NEXT_PUBLIC_NEAR_NETWORK=testnet                           # testnet or mainnet
NEXT_PUBLIC_NFT_CONTRACT_ID=your-contract.testnet          # NFT contract account ID

# Lit Protocol Configuration
NEXT_PUBLIC_LIT_ACTION_IPFS_CID=your-lit-action-cid        # Lit Action IPFS CID for PKP authentication
NEXT_PUBLIC_LIT_CAPACITY_TOKEN_ID=your-capacity-token-id   # Lit Protocol capacity credit token ID
LIT_DELEGATION_WALLET_PRIVATE_KEY=0x...                    # Ethereum private key (64 hex chars) for Lit PKP minting

# Lighthouse Storage
LIGHTHOUSE_API_KEY=your-lighthouse-api-key                 # Lighthouse.storage API key

# NEAR Relayer (for sponsored transactions)
RELAYER_ACCOUNT_ID=your-relayer.testnet                    # NEAR account ID for relayer
RELAYER_PRIVATE_KEY=ed25519:...                            # NEAR private key for relayer

# Optional: Self-Hosted Lit Relay & PDD (for development)
# LIT_RELAY_URL=http://localhost:3001
# LIT_RELAYER_API_KEY=self-hosted-test
# NEXT_PUBLIC_PDD_ENABLED=true
